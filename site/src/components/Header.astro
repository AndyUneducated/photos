---
interface Album {
  id: string;
  title: string;
  photoCount: number;
}

interface Props {
  title: string;
  tagline: string;
  albums: Album[];
  total: number;
}

const { title, tagline, albums, total } = Astro.props;
// With one album the chips would just be "All" and a duplicate of it, so that album gets a
// static label instead; visitors should still see which album they are looking at.
const showFilter = albums.length > 1;
const soleAlbum = albums.length === 1 ? albums[0] : null;
// Names for the downloaded ZIP / share sheet, keyed like the filter's data-album values.
const titles = JSON.stringify(Object.fromEntries([['all', title], ...albums.map((a) => [a.id, a.title])]));
---

<header class="header">
  <div class="header__inner">
    <div class="topline">
      <div class="brand">
        <span class="brand__title">{title}</span>
        {tagline && <span class="brand__tagline">{tagline}</span>}
      </div>

      {
        albums.length > 0 && (
          <button class="dl" id="album-download" type="button" data-titles={titles} title="Download every photo in this album">
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
              <path d="M10 3.5v9" />
              <path d="M6.5 9 10 12.5 13.5 9" />
              <path d="M4 14.5v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-1" />
            </svg>
            <span class="dl__label">Download</span>
          </button>
        )
      }
    </div>

    {
      showFilter && (
        <nav class="filter" id="filter" aria-label="Album filter">
          <div class="filter__track" role="group">
            <button class="chip is-active" type="button" data-album="all" aria-pressed="true">
              <span class="chip__label">All</span>
              <span class="chip__count">{total}</span>
            </button>
            {albums.map((album) => (
              <button class="chip" type="button" data-album={album.id} aria-pressed="false">
                <span class="chip__label">{album.title}</span>
                <span class="chip__count">{album.photoCount}</span>
              </button>
            ))}
          </div>
        </nav>
      )
    }

    {
      soleAlbum && (
        <div class="album-label" aria-label="Album">
          <span class="chip is-static">
            <span class="chip__label">{soleAlbum.title}</span>
            <span class="chip__count">{soleAlbum.photoCount}</span>
          </span>
        </div>
      )
    }
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-header);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    backdrop-filter: blur(18px) saturate(1.5);
    border-bottom: 1px solid var(--line-soft);
  }

  .header__inner {
    max-width: var(--shell-max);
    margin-inline: auto;
    padding-inline: var(--pad-x);
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* --- brand --------------------------------------------------------- */

  .topline {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .brand {
    flex: 1 1 auto;
    display: flex;
    align-items: baseline;
    gap: 9px;
    min-height: 40px;
    padding-top: 2px;
    min-width: 0;
  }

  .brand__title {
    font-size: 15px;
    font-weight: 620;
    letter-spacing: -0.021em;
    white-space: nowrap;
  }

  .brand__tagline {
    font-size: 11.5px;
    color: var(--fg-faint);
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* --- album filter -------------------------------------------------- */

  .filter {
    /* Edge fade instead of a scrollbar: the row is obviously scrollable
       without spending any vertical space on chrome. */
    --fade: 18px;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    margin-inline: calc(var(--pad-x) * -1);
    padding-inline: var(--pad-x);
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 var(--fade),
      #000 calc(100% - var(--fade)),
      transparent 100%
    );

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .filter__track {
    display: flex;
    gap: 6px;
    width: max-content;
    padding-block: 2px 9px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--fg-dim);
    font-size: 12.5px;
    line-height: 1.35;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.18s var(--ease),
      color 0.18s var(--ease),
      border-color 0.18s var(--ease);

    &:hover {
      color: var(--fg);
      border-color: color-mix(in oklab, var(--fg) 26%, transparent);
    }

    &.is-active {
      background: var(--fg);
      border-color: var(--fg);
      color: var(--bg);
    }
  }

  .chip.is-static {
    cursor: default;
    max-width: 100%;

    &:hover {
      color: var(--fg-dim);
      border-color: var(--line);
    }

    .chip__label {
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  .album-label {
    display: flex;
    min-width: 0;
    padding-block: 2px 9px;
  }

  /* --- download ----------------------------------------------------- */

  .dl {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px 5px 9px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--fg-dim);
    font-size: 12.5px;
    line-height: 1.35;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 0.18s var(--ease),
      border-color 0.18s var(--ease);

    svg {
      fill: none;
      stroke: currentColor;
      stroke-width: 1.6;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    &:hover {
      color: var(--fg);
      border-color: color-mix(in oklab, var(--fg) 26%, transparent);
    }

    &:disabled {
      opacity: 0.5;
      cursor: progress;
    }
  }

  .chip__count {
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    /* Interpolating between two opaque tokens rather than fading currentcolor into
       `transparent`. The old mix followed the label colour, so on the selected chip — where the
       label flips to the near-black background token — the count faded into the light fill and
       disappeared. These two stay near 5:1 against whichever fill is behind them. */
    color: color-mix(in oklab, var(--fg) 52%, var(--bg));
  }

  .chip.is-active .chip__count {
    color: color-mix(in oklab, var(--bg) 62%, var(--fg));
  }

  /* Wide enough: brand and filter share one line so the header stays ~54px. */
  @media (min-width: 760px) {
    .header__inner {
      flex-direction: row;
      align-items: center;
      gap: 24px;
      min-height: var(--header-h);
    }

    /* Brand, then the filter or album name, then the download button last on the row. */
    .topline {
      display: contents;
    }

    .dl {
      order: 1;
    }

    .brand {
      min-height: 0;
      padding-top: 0;
      flex: 0 0 auto;
    }

    .brand__title {
      font-size: 16.5px;
    }

    .filter {
      flex: 1 1 auto;
      min-width: 0;
      margin-inline: 0 calc(var(--pad-x) * -1);
      padding-inline: 0 var(--pad-x);
    }

    .filter__track {
      padding-block: 0;
      margin-left: auto;
    }

    .album-label {
      flex: 1 1 auto;
      justify-content: flex-end;
      padding-block: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chip {
      transition-duration: 0.01ms;
    }
  }
</style>
