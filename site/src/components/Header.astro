---
interface Album {
  id: string;
  title: string;
  photoCount: number;
}

interface Props {
  title: string;
  tagline: string;
  albums: Album[];
  total: number;
}

const { title, tagline, albums, total } = Astro.props;
// With one album the chips would just be "全部" and a duplicate of it.
const showFilter = albums.length > 1;
---

<header class="header">
  <div class="header__inner">
    <div class="brand">
      <span class="brand__title">{title}</span>
      {tagline && <span class="brand__tagline">{tagline}</span>}
    </div>

    {
      showFilter && (
        <nav class="filter" id="filter" aria-label="相册筛选">
          <div class="filter__track" role="group">
            <button class="chip is-active" type="button" data-album="all" aria-pressed="true">
              <span class="chip__label">全部</span>
              <span class="chip__count">{total}</span>
            </button>
            {albums.map((album) => (
              <button class="chip" type="button" data-album={album.id} aria-pressed="false">
                <span class="chip__label">{album.title}</span>
                <span class="chip__count">{album.photoCount}</span>
              </button>
            ))}
          </div>
        </nav>
      )
    }
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-header);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    backdrop-filter: blur(18px) saturate(1.5);
    border-bottom: 1px solid var(--line-soft);
  }

  .header__inner {
    max-width: var(--shell-max);
    margin-inline: auto;
    padding-inline: var(--pad-x);
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* --- brand --------------------------------------------------------- */

  .brand {
    display: flex;
    align-items: baseline;
    gap: 9px;
    min-height: 40px;
    padding-top: 2px;
    min-width: 0;
  }

  .brand__title {
    font-size: 15px;
    font-weight: 620;
    letter-spacing: -0.021em;
    white-space: nowrap;
  }

  .brand__tagline {
    font-size: 11.5px;
    color: var(--fg-faint);
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* --- album filter -------------------------------------------------- */

  .filter {
    /* Edge fade instead of a scrollbar: the row is obviously scrollable
       without spending any vertical space on chrome. */
    --fade: 18px;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    margin-inline: calc(var(--pad-x) * -1);
    padding-inline: var(--pad-x);
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 var(--fade),
      #000 calc(100% - var(--fade)),
      transparent 100%
    );

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .filter__track {
    display: flex;
    gap: 6px;
    width: max-content;
    padding-block: 2px 9px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--fg-dim);
    font-size: 12.5px;
    line-height: 1.35;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.18s var(--ease),
      color 0.18s var(--ease),
      border-color 0.18s var(--ease);

    &:hover {
      color: var(--fg);
      border-color: color-mix(in oklab, var(--fg) 26%, transparent);
    }

    &.is-active {
      background: var(--fg);
      border-color: var(--fg);
      color: var(--bg);
    }
  }

  .chip__count {
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    /* Interpolating between two opaque tokens rather than fading currentcolor into
       `transparent`. The old mix followed the label colour, so on the selected chip — where the
       label flips to the near-black background token — the count faded into the light fill and
       disappeared. These two stay near 5:1 against whichever fill is behind them. */
    color: color-mix(in oklab, var(--fg) 52%, var(--bg));
  }

  .chip.is-active .chip__count {
    color: color-mix(in oklab, var(--bg) 62%, var(--fg));
  }

  /* Wide enough: brand and filter share one line so the header stays ~54px. */
  @media (min-width: 760px) {
    .header__inner {
      flex-direction: row;
      align-items: center;
      gap: 24px;
      min-height: var(--header-h);
    }

    .brand {
      min-height: 0;
      padding-top: 0;
      flex: 0 0 auto;
    }

    .brand__title {
      font-size: 16.5px;
    }

    .filter {
      flex: 1 1 auto;
      min-width: 0;
      margin-inline: 0 calc(var(--pad-x) * -1);
      padding-inline: 0 var(--pad-x);
    }

    .filter__track {
      padding-block: 0;
      margin-left: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chip {
      transition-duration: 0.01ms;
    }
  }
</style>
