---
// Shown when the manifest has no photos at all — a fresh clone, or a gallery
// that has not been uploaded to yet. It should read as "nothing here yet",
// never as "this page is broken".
---

<div class="empty">
  <div class="empty__mark" aria-hidden="true">
    <svg viewBox="0 0 48 48" width="40" height="40">
      <rect x="6.5" y="11.5" width="35" height="25" rx="4" />
      <circle cx="24" cy="24" r="7" />
      <path d="M17 11.5l2.4-4h9.2l2.4 4" />
    </svg>
  </div>
  <p class="empty__title">还没有照片</p>
  <p class="empty__hint">
    运行 <code>npm run studio</code> 打开上传工具，添加照片后重新构建站点。
  </p>
</div>

<style>
  .empty {
    min-height: 62vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 40px var(--pad-x);
    text-align: center;
  }

  .empty__mark svg {
    fill: none;
    stroke: var(--fg-faint);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.7;
  }

  .empty__title {
    margin: 14px 0 0;
    font-size: 16px;
    font-weight: 560;
    letter-spacing: -0.015em;
  }

  .empty__hint {
    margin: 0;
    max-width: 34ch;
    font-size: 13px;
    line-height: 1.6;
    color: var(--fg-dim);
  }

  code {
    padding: 1.5px 6px;
    border-radius: 5px;
    background: var(--bg-raised);
    border: 1px solid var(--line-soft);
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
    font-size: 12px;
    color: var(--fg);
  }
</style>
